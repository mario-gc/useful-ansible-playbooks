# Ansible Playbook Configuration
# Copy this file to .env and customize as needed

# Required: Path to playbook (relative to repo root)
ANSIBLE_PLAYBOOK=playbooks/example/playbook.yml

# Required: Path to inventory file (relative to repo root)
ANSIBLE_INVENTORY=inventory/inventory.ini

# Optional: Extra variables file (YAML or JSON)
# ANSIBLE_EXTRA_VARS=inventory/group_vars/all.yml

# Optional: SSH key filename in ~/.ssh/
ANSIBLE_SSH_KEY=id_rsa

# Optional: Avoid Host key verification failed
ANSIBLE_HOST_KEY_CHECKING=False

# Optional: Run in check mode (dry run)
ANSIBLE_CHECK_MODE=True
